{
    "name": "pestphp/pest-plugin-ai",
    "description": "AI verification plugin for Pest",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "plugin",
        "ai"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "pestphp/pest": "^4.4.5",
        "pestphp/pest-plugin": "^4.0.0",
        "laravel/pao": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Pest\\AI\\": "src/"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "require-dev": {
        "pestphp/pest-dev-tools": "^4.1.0",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-type-coverage": "^4.0.3"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "pest": {
            "plugins": [
                "Pest\\AI\\Plugin"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "refactor": "rector",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": "pint --test",
        "test:unit": "pest --colors=always",
        "test:types": "phpstan",
        "test:refactor": "rector --dry-run",
        "test": [
            "@test:refactor",
            "@test:lint",
            "@test:type-coverage",
            "@test:types",
            "@test:unit"
        ]
    }
}
